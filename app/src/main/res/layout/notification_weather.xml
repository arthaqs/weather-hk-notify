<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="#FF1A1A2E"
    android:padding="8dp">

    <!-- Day 1 -->
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical" android:gravity="center">
        <TextView android:id="@+id/day1" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#FFAAAAAA" android:textSize="12sp" android:gravity="center"/>
        <TextView android:id="@+id/icon1" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="20sp" android:gravity="center"/>
        <TextView android:id="@+id/max1" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF" android:textSize="13sp" android:textStyle="bold" android:gravity="center"/>
        <TextView android:id="@+id/min1" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#FF888888" android:textSize="12sp" android:gravity="center"/>
    </LinearLayout>

    <!-- Day 2 -->
